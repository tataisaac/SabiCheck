# ---- SabiCheck API configuration -------------------------------------------
# Copy to `.env` for local development. NEVER commit a real key.

# Port to listen on (Cloud Run injects PORT automatically).
PORT=8080

# "gemini" (real AI) or "mock" (deterministic heuristic answers, no key needed).
# If unset: "gemini" when GEMINI_API_KEY is present, otherwise the server refuses
# to start so a missing key can never silently ship a mock to production.
SABICHECK_MODE=mock

# Gemini API key (https://aistudio.google.com/apikey). Lives ONLY on the server.
GEMINI_API_KEY=

# Model + tuning.
GEMINI_MODEL=gemini-2.5-flash
# Thinking budget in tokens. 0 disables thinking on gemini-2.5-flash (faster and
# cheaper — good for short scam checks). Leave empty to use the model default.
GEMINI_THINKING_BUDGET=0
GEMINI_TIMEOUT_MS=30000

# Optional shared secret. When set, clients must send
# `Authorization: Bearer <token>` on /v1/* routes. This is a low bar against
# casual abuse (anything in a mobile binary can be extracted) — real protection
# is the rate limit + your Gemini quota caps.
SABICHECK_APP_TOKEN=

# CORS for the Flutter web build. Comma-separated origins, or * (default).
ALLOWED_ORIGINS=*

# Per-IP rate limit for /v1/* routes.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=30

# Input limits.
MAX_TEXT_CHARS=8000
MAX_IMAGE_BYTES=5242880

# Result cache (identical input + language → same answer, no second AI call).
CACHE_TTL_SECONDS=86400
CACHE_MAX_ENTRIES=500

# Express "trust proxy" setting. 1 = trust the first hop (Cloud Run / most PaaS).
TRUST_PROXY=1
