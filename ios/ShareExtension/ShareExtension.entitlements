<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Same App Group as Runner.entitlements. Xcode manages this when you add the
	     "App Groups" capability; kept here as the reference value. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.incredible.sabicheck</string>
	</array>
</dict>
</plist>
